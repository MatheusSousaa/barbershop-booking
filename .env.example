# Valores fictícios para desenvolvimento local. Troque antes de publicar.
DB_NAME=barbershop
DB_USERNAME=barbershop
DB_PASSWORD=troque-esta-senha-local
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# Conta criada no primeiro startup
BARBER_INITIAL_USERNAME=barbeiro
BARBER_INITIAL_EMAIL=barbeiro@example.invalid
BARBER_INITIAL_PASSWORD=troque-esta-senha-inicial
BARBER_INITIAL_NAME=Barbeiro

# Encaminhamento de IP: mantenha none sem proxy reverso confiável
FORWARD_HEADERS_STRATEGY=none

# SMTP opcional; vazio usa notificações em log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_RECIPIENT=

# CORS: origens de frontend externas, separadas por vírgula (se houver)
CORS_ALLOWED_ORIGINS=http://localhost:8080
